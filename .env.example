# Copie para .env e preencha. Sem nenhuma variável o sistema roda com
# modelo falso e adaptadores locais (é o que o `npm run demo` usa).

# Servidor
PORTA=
WEBHOOK_TOKEN=

# Cadeia de modelos, em ordem de tentativa. Formato: provedor:modelo,provedor:modelo
# Provedores aceitos: anthropic, openai, fake
CADEIA_MODELOS=
MODELO_TIMEOUT_MS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Mídia
GROQ_API_KEY=
GROQ_MODELO_WHISPER=
VISAO_MODELO_ANTHROPIC=

# Destino da tarefa: json (padrão) ou clickup
DESTINO=
CLICKUP_TOKEN=
CLICKUP_LISTA_ID=

# Alerta: console (padrão) ou smtp
ALERTA=
SMTP_HOST=
SMTP_PORTA=
SMTP_USUARIO=
SMTP_SENHA=
ALERTA_DE=
ALERTA_PARA=

# Pasta dos dados locais (tarefas, mensagens guardadas, registro de ids)
PASTA_DADOS=
